# =============================================================================
# Dockerfile.pdf — Standalone PDF generation server (Puppeteer + Express)
# =============================================================================
# Produces a container that runs the PDF server from src/pdf/pdfServer.ts
# using tsx (no webpack build required).
#
# Build:  podman build -f Dockerfile.pdf -t content-sources-pdf-server .
# Run:    podman run -p 8000:8000 content-sources-pdf-server

# ─── Stage 1: Builder ───────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-22:9.8-1780375952 AS builder

# Let Puppeteer download chrome-headless-shell (not full Chrome)
ENV PUPPETEER_SKIP_CHROME_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROME_HEADLESS_SHELL_DOWNLOAD=false

USER 0
WORKDIR /app

# Copy dependency manifests first for layer caching
COPY package.json yarn.lock ./

# Install all deps (including dev: tsx, TypeScript, React, PatternFly)
RUN npm i -g yarn && yarn install --frozen-lockfile --network-timeout 600000

# Copy source needed at runtime (tsx runs TypeScript directly)
COPY tsconfig.json ./
COPY src/ src/

# ─── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-22:9.8-1780375952

LABEL name="content-sources-pdf-server" \
      com.redhat.component="content-sources-pdf-server" \
      description="PDF generation service for Content Sources / Lightwell" \
      io.k8s.description="PDF generation service using Puppeteer headless Chrome" \
      summary="Converts vulnerability data into PDF reports via headless Chrome" \
      version="1.0" \
      release="1" \
      vendor="Red Hat, Inc." \
      distribution-scope="private"

USER 0

# Chrome headless runtime dependencies
RUN dnf --nogpgcheck install -y \
    bzip2 fontconfig nss pango libXcomposite libXcursor libXdamage \
    libXext libXi libXtst cups-libs libXScrnSaver libXrandr alsa-lib \
    atk gtk3 libdrm libgbm libxshmfence && \
    dnf clean all

WORKDIR /app

COPY --from=builder --chown=1001:0 /app/node_modules ./node_modules
COPY --from=builder --chown=1001:0 /app/src ./src
COPY --from=builder --chown=1001:0 /app/tsconfig.json ./
COPY --from=builder --chown=1001:0 /app/package.json ./

# Copy Puppeteer's chrome-headless-shell cache
COPY --from=builder --chown=1001:0 /opt/app-root/src/.cache/puppeteer /opt/app-root/src/.cache/puppeteer

ENV HOME=/opt/app-root/src
ENV NODE_ENV=production
ENV PDF_SERVER_PORT=8000

# Drop to non-root user (OpenShift restricted-SCC compatible)
USER 1001
EXPOSE 8000

# tsx runs TypeScript directly — same entrypoint as "yarn start:pdf"
CMD ["npx", "tsx", "-r", "./src/pdf/register-css-stub.ts", "src/pdf/pdfServer.ts"]
